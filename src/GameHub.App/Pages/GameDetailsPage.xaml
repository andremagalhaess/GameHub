<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameHub.App.Pages.GameDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GameHub.App.Controls">

    <Grid>
    <ScrollViewer>
        <Grid>
            <!-- Fundo em destaque -->
            <Grid Height="460" VerticalAlignment="Top">
                <Image x:Name="HeroImage" Stretch="UniformToFill" VerticalAlignment="Top" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{ThemeResource GhPageFadeTransparent}" Offset="0" />
                            <GradientStop Color="{ThemeResource GhPageFadeTransparent}" Offset="0.35" />
                            <GradientStop Color="{ThemeResource GhPageFadeColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <StackPanel Padding="40,190,40,48" Spacing="0">
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:GameCoverCard x:Name="Cover" CoverWidth="220" ShowCaption="False" VerticalAlignment="Top" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="10">
                        <Image x:Name="LogoImage" MaxHeight="110" MaxWidth="440" HorizontalAlignment="Left" Stretch="Uniform" />
                        <TextBlock x:Name="TitleText" FontSize="40" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource GhMuted}" />

                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                            <Button x:Name="PlayButton" Style="{StaticResource GhPlayButton}" Click="Play_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE768;" FontSize="16" />
                                    <TextBlock Text="JOGAR" />
                                </StackPanel>
                            </Button>
                            <ToggleButton x:Name="FavButton" Click="Fav_Click" Height="44" ToolTipService.ToolTip="Favoritar">
                                <FontIcon x:Name="FavIcon" Glyph="&#xEB51;" FontSize="16" />
                            </ToggleButton>
                            <ComboBox x:Name="StatusBox" Height="44" MinWidth="160" SelectionChanged="Status_Changed" VerticalAlignment="Center"
                                      ToolTipService.ToolTip="Status" />
                            <Button Height="44" Click="Edit_Click" ToolTipService.ToolTip="Editar informações">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                    <TextBlock Text="Editar" />
                                </StackPanel>
                            </Button>
                            <Button Height="44" ToolTipService.ToolTip="Mais opções">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem Text="Atualizar informações online" Click="Refresh_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Alterar capa…" Click="ChangeCover_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Alterar background…" Click="ChangeBackground_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE91B;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="OpenFolderItem" Text="Abrir pasta do jogo" Click="OpenFolder_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Remover da biblioteca" Click="Remove_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="Info" IsOpen="False" Margin="0,20,0,0" />

                <Grid Margin="0,28,0,0" ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="20">
                        <Border Style="{StaticResource GhCard}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel><TextBlock x:Name="HoursText" Style="{StaticResource GhStatValue}" /><TextBlock Text="Horas jogadas" Style="{StaticResource GhMuted}" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock x:Name="LastPlayedText" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,4" /><TextBlock Text="Última vez" Style="{StaticResource GhMuted}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock x:Name="RatingText" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,4" /><TextBlock x:Name="RatingSource" Text="Nota externa" Style="{StaticResource GhMuted}" /></StackPanel>
                            </Grid>
                        </Border>

                        <!-- Minha avaliação -->
                        <Border Style="{StaticResource GhCard}" Padding="20">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <TextBlock Text="Minha avaliação" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <Button x:Name="ReviewButton" HorizontalAlignment="Right" Click="Review_Click" Style="{StaticResource GhPrimaryButton}" Padding="16,6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE734;" FontSize="14" />
                                            <TextBlock x:Name="ReviewButtonText" Text="Registrar avaliação" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="18">
                                    <Border Background="{StaticResource GhAccentSoftBrush}" CornerRadius="12" Padding="18,6" MinWidth="96">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="MyRatingText" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Text="de 10" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Name="MyStatusText" FontWeight="SemiBold" />
                                        <TextBlock x:Name="MyDatesText" Style="{StaticResource GhMuted}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="ReviewText" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="22" />
                                <Grid x:Name="ProsConsGrid" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="👍 Pontos positivos" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ProsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="👎 Pontos negativos" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ConsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="MomentsPanel" Spacing="4">
                                    <TextBlock Text="✨ Momentos memoráveis" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MomentsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel x:Name="CommentsPanel" Spacing="4">
                                    <TextBlock Text="Comentários" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CommentsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Memórias -->
                        <Border Style="{StaticResource GhCard}" Padding="20">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Memórias" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="Screenshots, momentos favoritos, cenas marcantes e anotações suas." Style="{StaticResource GhMuted}" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="AddMemory_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                                            <TextBlock Text="Adicionar memória" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <controls:WrapPanel x:Name="MemoriesPanel" HorizontalSpacing="12" VerticalSpacing="12" />
                                <TextBlock x:Name="MemoriesEmpty" Text="Nenhuma memória ainda." Style="{StaticResource GhMuted}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Sobre o jogo" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="22" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Top">
                        <Border Style="{StaticResource GhCard}">
                            <StackPanel x:Name="FactsPanel" Spacing="12" />
                        </Border>
                        <Border x:Name="PlatformsCard" Style="{StaticResource GhCard}" Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Plataformas vinculadas" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel x:Name="PlatformsPanel" Spacing="8" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>

    <!-- Registro de avaliação -->
    <ContentDialog x:Name="ReviewDialog" Title="Minha avaliação" PrimaryButtonText="Salvar" CloseButtonText="Cancelar"
                   DefaultButton="Primary" PrimaryButtonClick="ReviewDialog_PrimaryButtonClick">
        <ScrollViewer MaxHeight="600">
            <StackPanel Spacing="14" Width="520" Padding="0,0,16,0">
                <StackPanel Spacing="4">
                    <Grid>
                        <TextBlock Text="Nota (0 a 10)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <CheckBox x:Name="NoRatingBox" Content="Sem nota" HorizontalAlignment="Right" Checked="NoRating_Changed" Unchecked="NoRating_Changed" />
                    </Grid>
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                        <Slider x:Name="RatingSlider" Minimum="0" Maximum="10" StepFrequency="0.5" SmallChange="0.5" LargeChange="1"
                                TickFrequency="1" TickPlacement="Outside" ValueChanged="RatingSlider_ValueChanged" />
                        <TextBlock x:Name="RatingValue" Grid.Column="1" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource GhAccentBrush}" />
                    </Grid>
                </StackPanel>
                <ComboBox x:Name="ReviewStatus" Header="Status" MinWidth="200" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CalendarDatePicker x:Name="StartedPicker" Header="Comecei em" PlaceholderText="Escolher data" />
                    <CalendarDatePicker x:Name="FinishedPicker" Header="Terminei em" PlaceholderText="Escolher data" />
                </StackPanel>
                <TextBox x:Name="ReviewBox" Header="Review" TextWrapping="Wrap" AcceptsReturn="True" Height="130" PlaceholderText="O que achou do jogo?" />
                <TextBox x:Name="ProsBox" Header="Pontos positivos" TextWrapping="Wrap" AcceptsReturn="True" Height="70" />
                <TextBox x:Name="ConsBox" Header="Pontos negativos" TextWrapping="Wrap" AcceptsReturn="True" Height="70" />
                <TextBox x:Name="MomentsBox" Header="Momentos memoráveis" TextWrapping="Wrap" AcceptsReturn="True" Height="70" />
                <TextBox x:Name="CommentsBox" Header="Comentários" TextWrapping="Wrap" AcceptsReturn="True" Height="60" />
                <TextBox x:Name="ReviewTagsBox" Header="Tags (separadas por vírgula)" />
            </StackPanel>
        </ScrollViewer>
    </ContentDialog>
    </Grid>
</Page>

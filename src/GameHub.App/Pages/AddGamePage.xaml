<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameHub.App.Pages.AddGamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:metadata="using:GameHub.Core.Metadata"
    xmlns:helpers="using:GameHub.App.Helpers"
    xmlns:controls="using:GameHub.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Padding="32,16,32,12">
            <TextBlock x:Name="PageTitle" Text="Adicionar jogo" Style="{StaticResource GhPageTitle}" />
            <TextBlock x:Name="StepText" Style="{StaticResource GhMuted}" />
        </StackPanel>

        <!-- PASSO 1: escolher o executável -->
        <ScrollViewer x:Name="StepExe" Grid.Row="1">
            <StackPanel Padding="32,0,32,32" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
                <Border Style="{StaticResource GhCard}" Padding="28">
                    <StackPanel Spacing="12">
                        <FontIcon Glyph="&#xE7FC;" FontSize="36" HorizontalAlignment="Left" Foreground="{StaticResource GhAccentBrush}" />
                        <TextBlock Text="Escolha o executável do jogo" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Style="{StaticResource GhMuted}" TextWrapping="Wrap"
                                   Text="O GameHub lê o nome do arquivo, o Product Name, a descrição, a empresa e a pasta de instalação para sugerir o nome do jogo. O arquivo não é executado." />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                            <Button Style="{StaticResource GhPrimaryButton}" Click="PickExe_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock Text="SELECIONAR .EXE" />
                                </StackPanel>
                            </Button>
                            <Button Content="Adicionar sem executável" Click="NoExe_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ExeDetails" Spacing="16" Visibility="Collapsed">
                    <InfoBar x:Name="DuplicateInfo" Severity="Warning" IsOpen="False" IsClosable="True" Title="Possível duplicado" />

                    <Border Style="{StaticResource GhCard}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Nome sugerido" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBox x:Name="NameBox" FontSize="18" KeyDown="NameBox_KeyDown" />
                            <TextBlock x:Name="SuggestionSource" Style="{StaticResource GhMuted}" FontSize="12" />
                            <StackPanel x:Name="CandidatesPanel" Orientation="Horizontal" Spacing="6" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                <Button Style="{StaticResource GhPrimaryButton}" Click="Search_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                                        <TextBlock Text="BUSCAR INFORMAÇÕES ONLINE" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Preencher manualmente" Click="Manual_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Expander Header="Informações lidas do executável" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="ExeFacts" Spacing="6" />
                    </Expander>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- PASSO 2: escolher entre os resultados -->
        <Grid x:Name="StepResults" Grid.Row="1" Padding="32,0,32,0" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="10" MaxWidth="900" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="Nome do jogo" MinWidth="420" KeyDown="SearchBox_KeyDown" />
                <Button Grid.Column="1" Content="Buscar de novo" Click="SearchAgain_Click" />
            </Grid>
            <StackPanel Grid.Row="1" Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
                <StackPanel x:Name="SearchingPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="20" Height="20" />
                    <TextBlock x:Name="SearchingText" Text="Buscando…" VerticalAlignment="Center" />
                </StackPanel>
                <InfoBar x:Name="SearchInfo" IsOpen="False" IsClosable="True" />
                <TextBlock x:Name="ResultsHint" Style="{StaticResource GhMuted}" TextWrapping="Wrap"
                           Text="Escolha o jogo correto. Nada é adicionado sem sua confirmação." />
            </StackPanel>
            <ListView x:Name="ResultsList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Result_Click"
                      MaxWidth="900" HorizontalAlignment="Left" Padding="0,0,0,16">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="metadata:GameSearchResult">
                        <Grid ColumnSpacing="16" Padding="4,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="72" Height="100" CornerRadius="6" Background="{ThemeResource GhPlaceholderBrush}">
                                <Image Source="{x:Bind helpers:ImageHelper.Remote(CoverUrl)}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <Border Background="{StaticResource GhAccentSoftBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Provider}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource GhMuted}" Visibility="{x:Bind helpers:Fmt.IfText(Subtitle)}" />
                                <TextBlock Text="{x:Bind ShortDescription}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Opacity="0.85"
                                           Visibility="{x:Bind helpers:Fmt.IfText(ShortDescription)}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- PASSO 3: confirmar e editar -->
        <ScrollViewer x:Name="StepConfirm" Grid.Row="1" Visibility="Collapsed">
            <controls:GameEditor x:Name="Editor" Margin="32,0,32,24" MaxWidth="1100" HorizontalAlignment="Left" />
        </ScrollViewer>

        <!-- Barra de ações -->
        <Border Grid.Row="2" Background="{ThemeResource GhGlassBrush}" BorderBrush="{ThemeResource GhCardBorderBrush}" BorderThickness="0,1,0,0" Padding="32,12">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="BackButton" Content="Voltar" Click="Back_Click" Visibility="Collapsed" />
                    <Button x:Name="NoneButton" Content="Nenhum desses: preencher manualmente" Click="Manual_Click" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                    <TextBlock x:Name="BusyText" VerticalAlignment="Center" Style="{StaticResource GhMuted}" />
                    <Button Content="CANCELAR" Click="Cancel_Click" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource GhPrimaryButton}" Click="Confirm_Click" Visibility="Collapsed">
                        <TextBlock x:Name="ConfirmText" Text="CONFIRMAR E ADICIONAR" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameHub.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,16,32,40" Spacing="14" MaxWidth="920" HorizontalAlignment="Left">
            <TextBlock Text="Configurações" Style="{StaticResource GhPageTitle}" />
            <InfoBar x:Name="Info" IsOpen="False" IsClosable="True" />

            <!-- Aparência -->
            <TextBlock Text="Aparência" Style="{StaticResource GhSectionTitle}" />
            <Border Style="{StaticResource GhCard}">
                <StackPanel Spacing="16">
                    <RadioButtons x:Name="ThemeRadios" Header="Tema" SelectionChanged="Theme_Changed" MaxColumns="3">
                        <RadioButton Content="Escuro" Tag="dark" />
                        <RadioButton Content="Claro" Tag="light" />
                        <RadioButton Content="Igual ao Windows" Tag="system" />
                    </RadioButtons>
                    <ToggleSwitch x:Name="TransparencyToggle" Header="Transparência (efeito Mica do Windows 11)" OnContent="Ativada" OffContent="Desativada" Toggled="Transparency_Toggled" />
                    <ToggleSwitch x:Name="AnimationsToggle" Header="Animações de transição" OnContent="Ativadas" OffContent="Desativadas" Toggled="Animations_Toggled" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Tamanho das capas na biblioteca" />
                        <Slider x:Name="CoverSlider" Minimum="110" Maximum="280" StepFrequency="10" SmallChange="10" Width="360" HorizontalAlignment="Left"
                                ValueChanged="Cover_Changed" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Cor de destaque" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource GhAccentBrush}" />
                            <Button Content="Alterar cor…">
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel Spacing="10">
                                            <ColorPicker x:Name="AccentPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False" IsHexInputVisible="True"
                                                         IsColorChannelTextInputVisible="False" ColorSpectrumShape="Ring" />
                                            <Button Content="Aplicar" Style="{StaticResource GhPrimaryButton}" Click="ApplyAccent_Click" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Integrações -->
            <TextBlock Text="Busca de informações online" Style="{StaticResource GhSectionTitle}" />
            <TextBlock Style="{StaticResource GhMuted}" TextWrapping="Wrap"
                       Text="As buscas só acontecem quando você clica em BUSCAR INFORMAÇÕES ONLINE. Chaves e segredos ficam cifrados com a proteção de dados do Windows (DPAPI) e nunca saem deste computador, exceto para o próprio serviço." />
            <Border Style="{StaticResource GhCard}">
                <StackPanel Spacing="10">
                    <ToggleSwitch x:Name="SteamToggle" Header="Loja Steam (não precisa de chave)" OnContent="Ativada" OffContent="Desativada" Toggled="Steam_Toggled" />
                    <TextBlock Style="{StaticResource GhMuted}" FontSize="12" TextWrapping="Wrap"
                               Text="Capas, logos, descrições em português, classificação indicativa brasileira e nota do Metacritic, para jogos vendidos na Steam." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GhCard}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="RAWG" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="RawgState" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Style="{StaticResource GhMuted}" FontSize="12" TextWrapping="Wrap"
                               Text="Mais de 500 mil jogos, inclusive fora da Steam. Crie uma chave gratuita em rawg.io/apidocs (requer conta RAWG)." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PasswordBox x:Name="RawgKey" PlaceholderText="Chave de API da RAWG" Width="380" />
                        <Button Content="Salvar" Click="SaveRawg_Click" />
                        <Button Content="Testar" Click="TestRawg_Click" />
                        <Button Content="Remover" Click="RemoveRawg_Click" />
                    </StackPanel>
                    <HyperlinkButton Content="Obter chave da RAWG" NavigateUri="https://rawg.io/apidocs" Padding="0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GhCard}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="IGDB (via Twitch)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="IgdbState" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Style="{StaticResource GhMuted}" FontSize="12" TextWrapping="Wrap"
                               Text="Base mais completa (capas oficiais em alta, artworks, trailers). Registre um aplicativo no Twitch Developer Console e cole o Client ID e o Client Secret." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="IgdbId" PlaceholderText="Client ID" Width="260" />
                        <PasswordBox x:Name="IgdbSecret" PlaceholderText="Client Secret" Width="260" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Salvar" Click="SaveIgdb_Click" />
                        <Button Content="Testar" Click="TestIgdb_Click" />
                        <Button Content="Remover" Click="RemoveIgdb_Click" />
                    </StackPanel>
                    <HyperlinkButton Content="Abrir o Twitch Developer Console" NavigateUri="https://dev.twitch.tv/console/apps" Padding="0" />
                </StackPanel>
            </Border>

            <!-- Plataformas -->
            <TextBlock Text="Plataformas e launchers" Style="{StaticResource GhSectionTitle}" />
            <TextBlock Style="{StaticResource GhMuted}" TextWrapping="Wrap"
                       Text="Em Biblioteca › Atualizar biblioteca, o GameHub procura jogos instalados lendo arquivos e registros locais de cada launcher. Nenhuma senha é pedida ou guardada. Escolha onde procurar:" />
            <Border Style="{StaticResource GhCard}">
                <StackPanel x:Name="ScannersPanel" Spacing="4" />
            </Border>
            <Border Style="{StaticResource GhCard}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="Steam: biblioteca completa e horas jogadas" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="SteamApiState" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Style="{StaticResource GhMuted}" FontSize="12" TextWrapping="Wrap"
                               Text="Opcional. Com a chave da Steam Web API e o seu SteamID64, o GameHub importa também os jogos não instalados e as horas registradas pela Steam (dado oficial). Seu perfil precisa ter &quot;Detalhes de jogos&quot; público." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PasswordBox x:Name="SteamKeyBox" PlaceholderText="Chave da Steam Web API" Width="300" />
                        <TextBox x:Name="SteamIdBox" PlaceholderText="SteamID64 (ex.: 7656119…)" Width="230" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Salvar" Click="SaveSteamApi_Click" />
                        <Button Content="Remover" Click="RemoveSteamApi_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <HyperlinkButton Content="Obter chave da Steam Web API" NavigateUri="https://steamcommunity.com/dev/apikey" Padding="0" />
                        <HyperlinkButton Content="Descobrir meu SteamID64" NavigateUri="https://steamcommunity.com/my/edit/info" Padding="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GhCard}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="IgnoredText" />
                    <Button Content="Permitir reimportar jogos removidos" Click="ClearIgnored_Click" />
                </StackPanel>
            </Border>

            <!-- Armazenamento -->
            <TextBlock Text="Dados e armazenamento" Style="{StaticResource GhSectionTitle}" />
            <Border Style="{StaticResource GhCard}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="DataPathText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="CacheSizeText" Style="{StaticResource GhMuted}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Abrir pasta de dados" Click="OpenData_Click" />
                        <Button Content="Limpar imagens não usadas" Click="CleanCache_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Backup -->
            <TextBlock Text="Backup e restauração" Style="{StaticResource GhSectionTitle}" />
            <Border Style="{StaticResource GhCard}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource GhMuted}" TextWrapping="Wrap"
                               Text="O backup (.zip) inclui banco de dados, perfil, jogos, tempo jogado e todas as imagens. Ao restaurar, o GameHub guarda antes uma cópia de segurança do estado atual." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="BackupBusy" IsActive="False" Width="20" Height="20" />
                        <Button Content="Criar backup…" Click="Backup_Click" Style="{StaticResource GhPrimaryButton}" />
                        <Button Content="Restaurar backup…" Click="Restore_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Importar e exportar -->
            <TextBlock Text="Importar e exportar" Style="{StaticResource GhSectionTitle}" />
            <Border Style="{StaticResource GhCard}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource GhMuted}" TextWrapping="Wrap"
                               Text="Planilhas CSV (abrem no Excel). Exportar tudo gera quatro arquivos: jogos, reviews, jornada (datas, sessões e memórias) e rankings. Ao importar, jogos com o mesmo nome são atualizados em vez de duplicados, e nada é executado." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="ExchangeBusy" IsActive="False" Width="20" Height="20" />
                        <Button Content="Exportar tudo (CSV)…" Click="ExportAll_Click" Style="{StaticResource GhPrimaryButton}" />
                        <DropDownButton Content="Importar CSV">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="Jogos (GameHub ou planilha própria)…" Tag="games" Click="Import_Click" />
                                    <MenuFlyoutItem Text="Reviews…" Tag="reviews" Click="Import_Click" />
                                    <MenuFlyoutItem Text="Jornada (datas, sessões e memórias)…" Tag="journey" Click="Import_Click" />
                                    <MenuFlyoutItem Text="Rankings…" Tag="rankings" Click="Import_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                    <TextBlock Text="Backloggd" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource GhMuted}" TextWrapping="Wrap"
                               Text="O Backloggd não tem API pública, então não há sincronização automática. Você pode importar um CSV exportado do Backloggd (notas de 0,5 a 5 estrelas viram 1 a 10; jogos da wishlist são ignorados) e exportar suas avaliações e seu histórico num CSV com colunas em inglês para usar lá ou em outra ferramenta." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Importar CSV do Backloggd…" Tag="backloggd" Click="Import_Click" />
                        <Button Content="Exportar avaliações e histórico (CSV)…" Click="ExportBackloggd_Click" />
                    </StackPanel>
                    <InfoBar x:Name="ExchangeInfo" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <!-- Sobre -->
            <TextBlock Text="Sobre" Style="{StaticResource GhSectionTitle}" />
            <Border Style="{StaticResource GhCard}">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="VersionText" />
                    <TextBlock Text="Idioma: Português (Brasil)" Style="{StaticResource GhMuted}" />
                    <TextBlock Style="{StaticResource GhMuted}" TextWrapping="Wrap"
                               Text="O GameHub não inicia com o Windows, não fica na bandeja e não roda nada em segundo plano." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

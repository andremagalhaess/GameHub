<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameHub.App.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GameHub.Core.Models"
    xmlns:controls="using:GameHub.App.Controls">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="32,16,32,40">
                <!-- Banner + identidade -->
                <Grid Height="230" CornerRadius="16">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#557C5CFF" Offset="0" />
                            <GradientStop Color="#3300C8FF" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Image x:Name="BannerImage" Stretch="UniformToFill" VerticalAlignment="Center" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.3" />
                                <GradientStop Color="#B3000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Grid VerticalAlignment="Bottom" Padding="28,0,28,22" ColumnSpacing="20" RequestedTheme="Dark">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="60" BorderThickness="3" BorderBrush="{StaticResource GhAccentBrush}">
                            <PersonPicture x:Name="Avatar" Width="104" Height="104" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="2">
                            <TextBlock x:Name="NameText" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock x:Name="UserText" Opacity="0.8" />
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Bottom" Click="Edit_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                <TextBlock Text="Editar perfil" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <TextBlock x:Name="BioText" Margin="4,18,4,0" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />

                <!-- Jogando agora -->
                <Border x:Name="CurrentCard" Style="{StaticResource GhCard}" Margin="0,20,0,0" Visibility="Collapsed">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <controls:GameCoverCard x:Name="CurrentCover" CoverWidth="70" ShowCaption="False" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="JOGANDO AGORA" FontSize="12" FontWeight="SemiBold" CharacterSpacing="100" Foreground="{StaticResource GhAccentBrush}" />
                            <HyperlinkButton x:Name="CurrentTitle" Padding="0" FontSize="20" FontWeight="SemiBold" Click="Current_Click" />
                            <TextBlock x:Name="CurrentInfo" Style="{StaticResource GhMuted}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Estatísticas" Style="{StaticResource GhSectionTitle}" />
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource GhCard}">
                    <StackPanel><TextBlock x:Name="StTotal" Style="{StaticResource GhStatValue}" TextTrimming="CharacterEllipsis" /><TextBlock Text="Jogos cadastrados" Style="{StaticResource GhMuted}" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource GhCard}">
                    <StackPanel><TextBlock x:Name="StFinished" Style="{StaticResource GhStatValue}" TextTrimming="CharacterEllipsis" /><TextBlock Text="Zerados / 100%" Style="{StaticResource GhMuted}" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource GhCard}">
                    <StackPanel><TextBlock x:Name="StHours" Style="{StaticResource GhStatValue}" TextTrimming="CharacterEllipsis" /><TextBlock Text="Horas jogadas" Style="{StaticResource GhMuted}" /></StackPanel>
                </Border>
                <Border Grid.Column="3" Grid.Row="0" Style="{StaticResource GhCard}">
                    <StackPanel><TextBlock x:Name="StAvg" Style="{StaticResource GhStatValue}" TextTrimming="CharacterEllipsis" /><TextBlock Text="Média das avaliações" Style="{StaticResource GhMuted}" /></StackPanel>
                </Border>
                <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource GhCard}">
                    <StackPanel><TextBlock x:Name="StFav" Style="{StaticResource GhStatValue}" TextTrimming="CharacterEllipsis" /><TextBlock Text="Favoritos" Style="{StaticResource GhMuted}" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource GhCard}">
                    <StackPanel><TextBlock x:Name="StPlaying" Style="{StaticResource GhStatValue}" TextTrimming="CharacterEllipsis" /><TextBlock Text="Em andamento" Style="{StaticResource GhMuted}" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource GhCard}">
                    <StackPanel><TextBlock x:Name="StBest" Style="{StaticResource GhStatValue}" TextTrimming="CharacterEllipsis" /><TextBlock Text="Melhor avaliado" Style="{StaticResource GhMuted}" /></StackPanel>
                </Border>
                <Border Grid.Column="3" Grid.Row="1" Style="{StaticResource GhCard}">
                    <StackPanel><TextBlock x:Name="StGenre" Style="{StaticResource GhStatValue}" TextTrimming="CharacterEllipsis" /><TextBlock Text="Gênero favorito" Style="{StaticResource GhMuted}" /></StackPanel>
                </Border>
                </Grid>
                <TextBlock Text="Notas pessoais e reviews chegam na próxima etapa (Prioridade 2); até lá, as estatísticas de avaliação ficam vazias." Style="{StaticResource GhMuted}" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap" x:Name="RatingsHint" />

            <StackPanel x:Name="FavSection" Visibility="Collapsed">
                <TextBlock Text="Jogos favoritos" Style="{StaticResource GhSectionTitle}" />
                <ListView x:Name="FavList" Style="{StaticResource GhShelf}" ItemClick="Shelf_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Game">
                            <controls:GameCoverCard Game="{x:Bind}" CoverWidth="130" Margin="0,0,14,0" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
            <StackPanel x:Name="PlayingSection" Visibility="Collapsed">
                <TextBlock Text="Em andamento" Style="{StaticResource GhSectionTitle}" />
                <ListView x:Name="PlayingList" Style="{StaticResource GhShelf}" ItemClick="Shelf_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Game">
                            <controls:GameCoverCard Game="{x:Bind}" CoverWidth="130" Margin="0,0,14,0" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
            <StackPanel x:Name="FinishedSection" Visibility="Collapsed">
                <TextBlock Text="Zerados" Style="{StaticResource GhSectionTitle}" />
                <ListView x:Name="FinishedList" Style="{StaticResource GhShelf}" ItemClick="Shelf_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Game">
                            <controls:GameCoverCard Game="{x:Bind}" CoverWidth="130" Margin="0,0,14,0" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
            <StackPanel x:Name="AbandonedSection" Visibility="Collapsed">
                <TextBlock Text="Abandonados" Style="{StaticResource GhSectionTitle}" />
                <ListView x:Name="AbandonedList" Style="{StaticResource GhShelf}" ItemClick="Shelf_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Game">
                            <controls:GameCoverCard Game="{x:Bind}" CoverWidth="130" Margin="0,0,14,0" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Edição do perfil -->
        <ContentDialog x:Name="EditDialog" Title="Editar perfil" PrimaryButtonText="Salvar" CloseButtonText="Cancelar"
                       DefaultButton="Primary" PrimaryButtonClick="EditDialog_PrimaryButtonClick">
            <ScrollViewer MaxHeight="560">
                <StackPanel Spacing="14" Width="460" Padding="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <PersonPicture x:Name="EditAvatar" Width="64" Height="64" />
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <Button Content="Escolher foto…" Click="PickAvatar_Click" />
                            <Button Content="Remover foto" Click="RemoveAvatar_Click" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Escolher banner…" Click="PickBanner_Click" />
                        <Button Content="Remover banner" Click="RemoveBanner_Click" />
                        <TextBlock x:Name="BannerState" VerticalAlignment="Center" Style="{StaticResource GhMuted}" />
                    </StackPanel>
                    <TextBox x:Name="EditName" Header="Nome de exibição" />
                    <TextBox x:Name="EditUser" Header="Nome de usuário" />
                    <TextBox x:Name="EditBio" Header="Biografia" TextWrapping="Wrap" AcceptsReturn="True" Height="100" />
                    <ComboBox x:Name="EditCurrent" Header="Jogo atualmente jogado" HorizontalAlignment="Stretch" DisplayMemberPath="Title" />
                    <TextBlock Text="Cor de destaque" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ColorPicker x:Name="EditAccent" IsAlphaEnabled="False" IsMoreButtonVisible="False" IsColorChannelTextInputVisible="False"
                                 IsHexInputVisible="True" ColorSpectrumShape="Ring" />
                    <TextBlock x:Name="EditError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>

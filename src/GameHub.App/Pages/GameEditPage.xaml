<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameHub.App.Pages.GameEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GameHub.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Header" Text="Editar jogo" Style="{StaticResource GhPageTitle}" Margin="32,16,32,12" />
        <ScrollViewer Grid.Row="1">
            <controls:GameEditor x:Name="Editor" Margin="32,0,32,24" MaxWidth="1100" HorizontalAlignment="Left" />
        </ScrollViewer>
        <Border Grid.Row="2" Background="{ThemeResource GhGlassBrush}" BorderBrush="{ThemeResource GhCardBorderBrush}" BorderThickness="0,1,0,0" Padding="32,12">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                <Button Content="Cancelar" Click="Cancel_Click" />
                <Button x:Name="SaveButton" Content="SALVAR" Style="{StaticResource GhPrimaryButton}" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Page>

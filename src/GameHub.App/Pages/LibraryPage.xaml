<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameHub.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GameHub.Core.Models"
    xmlns:controls="using:GameHub.App.Controls">

    <Grid Padding="32,16,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Biblioteca" Style="{StaticResource GhPageTitle}" />
                <TextBlock x:Name="CountText" Style="{StaticResource GhMuted}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource GhPrimaryButton}" Click="Add_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="ADICIONAR JOGO" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,18,0,14">
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Buscar por nome, gênero ou desenvolvedora" Width="340"
                            QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="StatusFilter" Width="170" SelectionChanged="Selection_Changed" />
            <ComboBox x:Name="SortBox" Width="190" SelectionChanged="Selection_Changed">
                <ComboBoxItem Content="Nome (A–Z)" Tag="Title" />
                <ComboBoxItem Content="Adicionados recentemente" Tag="RecentlyAdded" />
                <ComboBoxItem Content="Jogados recentemente" Tag="RecentlyPlayed" />
                <ComboBoxItem Content="Mais horas" Tag="Playtime" />
                <ComboBoxItem Content="Lançamento" Tag="ReleaseDate" />
            </ComboBox>
            <ToggleButton x:Name="FavToggle" Click="Fav_Click" ToolTipService.ToolTip="Só favoritos">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xEB51;" FontSize="14" />
                    <TextBlock Text="Favoritos" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <GridView x:Name="GamesGrid" Grid.Row="2" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Grid_ItemClick"
                  Padding="0,0,0,32">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Game">
                    <controls:GameCoverCard Game="{x:Bind}" Margin="4" Loaded="Card_Loaded" />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel x:Name="EmptyState" Grid.Row="2" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <FontIcon Glyph="&#xE7FC;" FontSize="48" Foreground="{ThemeResource GhMutedTextBrush}" />
            <TextBlock x:Name="EmptyText" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
            <Button x:Name="EmptyAdd" Content="Adicionar seu primeiro jogo" HorizontalAlignment="Center" Style="{StaticResource GhPrimaryButton}" Click="Add_Click" />
        </StackPanel>
    </Grid>
</Page>

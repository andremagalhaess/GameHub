<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameHub.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GameHub.Core.Models"
    xmlns:controls="using:GameHub.App.Controls">

    <Grid Padding="32,16,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Biblioteca" Style="{StaticResource GhPageTitle}" />
                <TextBlock x:Name="CountText" Style="{StaticResource GhMuted}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ProgressRing x:Name="ImportBusy" IsActive="False" Width="20" Height="20" />
                <Button x:Name="ImportButton" Click="Import_Click" ToolTipService.ToolTip="Procura jogos instalados nas plataformas (Steam, Epic, GOG, Ubisoft, EA, Battle.net, Riot, Xbox…)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Atualizar biblioteca" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhPrimaryButton}" Click="Add_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="ADICIONAR JOGO" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="10" Margin="0,18,0,14">
        <InfoBar x:Name="ImportInfo" IsOpen="False" IsClosable="True" />
        <StackPanel Orientation="Horizontal" Spacing="10">
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Buscar por nome, gênero ou desenvolvedora" Width="340"
                            QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="StatusFilter" Width="170" SelectionChanged="Selection_Changed" />
            <ComboBox x:Name="SortBox" Width="190" SelectionChanged="Selection_Changed">
                <ComboBoxItem Content="Nome (A–Z)" Tag="Title" />
                <ComboBoxItem Content="Adicionados recentemente" Tag="RecentlyAdded" />
                <ComboBoxItem Content="Jogados recentemente" Tag="RecentlyPlayed" />
                <ComboBoxItem Content="Mais horas" Tag="Playtime" />
                <ComboBoxItem Content="Lançamento" Tag="ReleaseDate" />
                <ComboBoxItem Content="Minha nota" Tag="Rating" />
            </ComboBox>
            <ToggleButton x:Name="FavToggle" Click="Fav_Click" ToolTipService.ToolTip="Só favoritos">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xEB51;" FontSize="14" />
                    <TextBlock Text="Favoritos" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <ComboBox x:Name="GenreFilter" Width="200" SelectionChanged="Selection_Changed" />
            <ComboBox x:Name="SourceFilter" Width="210" SelectionChanged="Selection_Changed" />
            <ComboBox x:Name="RatingFilter" Width="160" SelectionChanged="Selection_Changed">
                <ComboBoxItem Content="Qualquer nota" />
                <ComboBoxItem Content="Nota 9 ou mais" Tag="9" />
                <ComboBoxItem Content="Nota 8 ou mais" Tag="8" />
                <ComboBoxItem Content="Nota 7 ou mais" Tag="7" />
                <ComboBoxItem Content="Nota 5 ou mais" Tag="5" />
            </ComboBox>
            <ComboBox x:Name="TimeFilter" Width="180" SelectionChanged="Selection_Changed">
                <ComboBoxItem Content="Qualquer tempo" />
                <ComboBoxItem Content="Nunca jogado" Tag="0-0" />
                <ComboBoxItem Content="Até 5 h" Tag="1-300" />
                <ComboBoxItem Content="5 a 20 h" Tag="300-1200" />
                <ComboBoxItem Content="20 a 50 h" Tag="1200-3000" />
                <ComboBoxItem Content="Mais de 50 h" Tag="3000-" />
            </ComboBox>
            <Button Content="Limpar filtros" Click="ClearFilters_Click" />
        </StackPanel>
        </StackPanel>

        <GridView x:Name="GamesGrid" Grid.Row="2" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Grid_ItemClick"
                  Padding="0,0,0,32">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Game">
                    <controls:GameCoverCard Game="{x:Bind}" Margin="4" Loaded="Card_Loaded" />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel x:Name="EmptyState" Grid.Row="2" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <FontIcon Glyph="&#xE7FC;" FontSize="48" Foreground="{ThemeResource GhMutedTextBrush}" />
            <TextBlock x:Name="EmptyText" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
            <Button x:Name="EmptyAdd" Content="Adicionar seu primeiro jogo" HorizontalAlignment="Center" Style="{StaticResource GhPrimaryButton}" Click="Add_Click" />
        </StackPanel>
    </Grid>
</Page>

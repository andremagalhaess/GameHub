<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameHub.App.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Border Style="{StaticResource GhCard}" MaxWidth="520" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16">
                <Image Source="ms-appx:///Assets/Logo256.png" Width="64" Height="64" HorizontalAlignment="Left" />
                <TextBlock Text="Bem-vindo ao GameHub" Style="{StaticResource GhPageTitle}" />
                <TextBlock Style="{StaticResource GhMuted}" TextWrapping="Wrap"
                           Text="Sua central de jogos e diário gamer. Tudo fica salvo só neste computador, sem conta online. Vamos criar seu perfil." />

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <PersonPicture x:Name="Avatar" Width="72" Height="72" />
                    <Button Content="Escolher foto" Click="PickAvatar_Click" VerticalAlignment="Center" />
                </StackPanel>

                <TextBox x:Name="NameBox" Header="Nome de exibição" PlaceholderText="Como quer ser chamado?" TextChanged="NameBox_TextChanged" />
                <TextBox x:Name="UserBox" Header="Nome de usuário" PlaceholderText="ex.: andre" />

                <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" TextWrapping="Wrap" />

                <Button x:Name="StartButton" Content="Começar" Style="{StaticResource GhPrimaryButton}" HorizontalAlignment="Stretch" IsEnabled="False" Click="Start_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GameHub.App.Controls.GameCoverCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="8">
        <Grid x:Name="CoverHost" CornerRadius="{StaticResource GhCoverRadius}" Background="{ThemeResource GhPlaceholderBrush}">
            <!-- Sem capa: mostra o nome sobre um degradê com a cor de destaque. -->
            <Grid x:Name="Placeholder">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#337C5CFF" Offset="0" />
                        <GradientStop Color="#2200C8FF" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <TextBlock x:Name="PlaceholderText" Margin="14" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="16"
                           VerticalAlignment="Bottom" MaxLines="4" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Image x:Name="Cover" ImageFailed="Cover_ImageFailed" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <Border x:Name="StatusBadge" Background="{ThemeResource GhGlassBrush}" CornerRadius="6" Padding="8,3"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <FontIcon x:Name="FavIcon" Glyph="&#xEB52;" FontSize="16" Foreground="{StaticResource GhAccentBrush}"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Visibility="Collapsed" />
        </Grid>
        <StackPanel x:Name="Caption" Spacing="1">
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock x:Name="SubText" Style="{StaticResource GhMuted}" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" />
        </StackPanel>
    </StackPanel>
</UserControl>
